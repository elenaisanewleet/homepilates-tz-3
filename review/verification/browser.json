  "pageMeta": [
    {
      "page": "/",
      "title": "Главная — HomePilates",
      "description": "Улучшаем осанку, снимаем боль в спине и шее, возвращаем легкость движения. Мини-группы до 7 человек и персональные тренировки в студии у м. Ботанический сад.",
      "fonts": [
        true,
        true
      ]
    },
    {
      "page": "napravleniya",
      "title": "Направления — HomePilates",
      "description": "У нас нет случайных занятий. Каждое направление решает конкретную задачу — от реабилитации до гибкости. Не знаете, с чего начать? Приходите на пробное занятие: тренер определит отправную точку и подскажет маршрут.",
      "fonts": [
        true,
        true
      ]
    },
    {
      "page": "raspisanie",
      "title": "Расписание — HomePilates",
      "description": "Выбирайте удобное время – запись занимает минуту. В таблице ниже актуальное расписание студии. Записывайтесь сами или меняйте запись в личном кабинете – без звонков и переписок.",
      "fonts": [
        true,
        true
      ]
    },
    {
      "page": "stoimost",
      "title": "Стоимость — HomePilates",
      "description": "Прозрачные цены – без скрытых условий. Пробное занятие – самый выгодный способ начать: после него вы получаете персональный план занятий по приятной стоимости.",
      "fonts": [
        true,
        true
      ]
    },
    {
      "page": "komanda",
      "title": "Команда — HomePilates",
      "description": "Нас немного – и это дарит нам уверенность. Вместо большой команды со сменными тренерами у нас пять специалистов, которые ведут вас от первой консультации до результата. Вы не будете каждый раз рассказывать свою историю заново.",
      "fonts": [
        true,
        true
      ]
    },
    {
      "page": "faq",
      "title": "FAQ — HomePilates",
      "description": "Отвечаем на вопросы, которые чаще всего приходят в личные сообщения.",
      "fonts": [
        true,
        true
      ]
    },
    {
      "page": "sertifikaty",
      "title": "Подарочные сертификаты — HomePilates",
      "description": "Подарок, который не пылится в шкафу. Сертификат HomePilates на 1, 2, 3 тренировки это не абстрактная косметичка, а реальные тренировки, после которых человек встает с кровати без боли в спине. Подойдет маме, которая забыла о себе после родов, другу с «офисной» спиной, партнеру, который все собирается заняться собой.",
      "fonts": [
        true,
        true
      ]
    },
    {
      "page": "kontakty",
      "title": "Контакты — HomePilates",
      "description": "Москва, проезд Серебрякова, д. 2 к.1, 2 минуты от м. Ботанический сад.",
      "fonts": [
        true,
        true
      ]
    }
